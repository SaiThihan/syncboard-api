# The API reads these from the environment and has no .env loader of its own.
# Copy this file to .env and start with Node's built-in flag:
#   node --env-file=.env dist/main.js
# or set them in front of the command:
#   PORT=3000 CORS_ORIGIN=http://localhost:5173 npm run start:dev

# Port the API listens on
PORT=3000
# The one browser address allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:5173
